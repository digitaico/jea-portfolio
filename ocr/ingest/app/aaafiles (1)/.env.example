# Copy to .env (same folder you launch uvicorn from). Single source of truth.

# app / server
APP_TITLE=Lector de Órdenes Médicas
MAX_UPLOAD_MB=20

# decode
PDF_DPI=200

# preprocess
MAX_IMAGE_DIM=2000

# storage
STORAGE_DIR=./app/storage

# ocr
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=60
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=4096
OCR_INPUT=processed
OCR_LANGUAGE_HINT=Spanish
OCR_TRANSCRIPTION_PROMPT_FILE=./app/prompts/transcription.txt
OCR_EXTRACTION_PROMPT_FILE=./app/prompts/extraction.txt
OCR_AREAS_FILE=./app/areas.json
READABILITY_MIN_SHARPNESS=30
READABILITY_MIN_BRIGHTNESS=50
READABILITY_MAX_BRIGHTNESS=240
READABILITY_MIN_CONTRAST=12
OCR_MAX_ILLEGIBLE_RATIO=0.5
